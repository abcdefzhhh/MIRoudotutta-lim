<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.SIPERPUS.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeColor="@color/outline_variant"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTipeTransaksi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_green"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:textColor="@color/on_primary_container"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Peminjaman" />

            <TextView
                android:id="@+id/tvWaktu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:textColor="@color/on_surface_variant"
                android:textSize="11sp"
                tools:text="Hari ini, 09:15 WIB" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge_gold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:textColor="@color/on_secondary_container"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="Dipinjam" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvNamaSiswa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/on_surface"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Muhammad Rizky Pratama" />

        <TextView
            android:id="@+id/tvKelasSiswa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/on_surface_variant"
            android:textSize="12sp"
            tools:text="Kelas V-A • NIS: 20240012" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="8dp"
            android:background="@color/outline_variant" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvJudulBuku"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/primary"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Fikih MI Kelas IV" />

            <TextView
                android:id="@+id/tvKodeBuku"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/on_surface_variant"
                android:textSize="11sp"
                tools:text="BK-2024-0891" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDendaInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/error"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="Denda: Rp 2.000 (Lunas)" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
